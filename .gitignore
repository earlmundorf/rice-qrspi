# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
build/
*.egg-info/
.gradle/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code
.claude/settings.local.json

# Published /cq:* commands — generated from .claude/skills/qrspi/commands/ by
# sync-commands.sh (or by install.sh in a target repo). The skill copy is canonical;
# tracking both would let them drift.
.claude/commands/cq/

# Logs
*.log
logs/

# QRSPI per-ticket scratch — keep the committed config, profiles and findings log,
# ignore the rest
working-docs/*
!working-docs/config.json
!working-docs/profiles/
!working-docs/findings/
!working-docs/findings/**
